{
  "name": "ripper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ripper — agentes de IA com Claude e ChatGPT por assinatura e um computador próprio por agente.",
  "scripts": {
    "start": "node server.mjs",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "dev:server": "node --watch server.mjs",
    "dev:web": "vite",
    "julia": "python julia/serve.py",
    "prod": "vite build && node server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.1.2",
    "liquid-gooey": "^0.2.2",
    "metal-fx": "^2.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "thinking-orbs": "^0.3.2",
    "voice-glow": "^0.2.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}

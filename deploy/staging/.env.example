# Copie para .env nesta pasta, ou deixe o `node scripts/staging.mjs up` gerar token e senha.
# O arquivo .env não entra no Git. Não use RIPPER_TOKEN / RIPPER_DATA / senha de produção.

# RIPPER_STAGING_TOKEN=
# RIPPER_STAGING_PASSWORD=
# RIPPER_STAGING_ID=   # gerado no primeiro up; precisa bater com .staging-claim
RIPPER_STAGING_PORT=3010
RIPPER_STAGING_PROVIDER=stream

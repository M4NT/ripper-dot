# Copie para .env nesta pasta, ou deixe o `node scripts/staging.mjs up` gerar o token.
# O arquivo .env não entra no Git. Não use RIPPER_TOKEN / RIPPER_DATA de produção.

# RIPPER_STAGING_TOKEN=
RIPPER_STAGING_PORT=3010
RIPPER_STAGING_PROVIDER=stream
RIPPER_STAGING_PASSWORD=staging-ok-8
RIPPER_ENV=staging
